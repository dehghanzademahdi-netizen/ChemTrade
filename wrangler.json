{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "chemlink",
  "compatibility_date": "2026-10-02",
  "main": "./worker.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
